# Redis shared truth
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram bot and webhook verification
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Canonical deployed HTTPS origin configured in Vercel. If unset, the app falls back
# to VERCEL_PROJECT_PRODUCTION_URL (also configured by Vercel for production).
PUBLIC_APP_ORIGIN=https://your-domain.example

# Public iCloud share link created after publishing and testing the stable Shortcut.
# This is not generated by Vercel.
PUBLIC_SHORTCUT_INSTALL_URL=

# Google OAuth web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/google/callback

# Base64url-encoded 32-byte AES-GCM key used to encrypt Google refresh tokens
GOOGLE_OAUTH_ENCRYPTION_KEY=

# Temporary admin invite endpoint
ADMIN_INVITE_SECRET=
